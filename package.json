{
  "name": "wechat-formatting-skill",
  "version": "0.1.0",
  "description": "公众号文章排版 Skill：将 Markdown 原文或大纲排版为符合微信公众号阅读习惯的最终文本，可被 Agent / Harness 作为技能或工具调用。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./rules/*": "./rules/*.md",
    "./templates/*": "./templates/*.md"
  },
  "bin": {
    "wechat-format": "./bin/wechat-format.js"
  },
  "files": [
    "src",
    "bin",
    "rules",
    "templates",
    "interface",
    "examples",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/wechat-format.js examples/input.md -o examples/expected-output.md",
    "format:check": "node bin/wechat-format.js examples/input.md --check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "wechat",
    "weixin",
    "公众号",
    "markdown",
    "排版",
    "skill",
    "agent",
    "llm"
  ],
  "license": "MIT"
}
