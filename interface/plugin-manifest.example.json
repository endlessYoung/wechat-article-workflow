{
  "$schema": "https://json.schemastore.org/plugin-manifest.json",
  "name": "wechat-formatting-skill",
  "version": "0.1.0",
  "description": "公众号视图层排版：Markdown/大纲 → 可粘贴公众号后台的内联样式 HTML，支持多主题。",
  "kind": "tool",
  "tools": [
    {
      "name": "wechat_format",
      "description": "将 Markdown 原文或结构化大纲排版为可直接粘贴微信公众号后台的内联样式 HTML 片段。",
      "contract": "./tool-contract.md",
      "inputSchema": "./options.schema.json",
      "runtime": {
        "type": "cli",
        "command": "wechat-format",
        "argsTemplate": ["--json"]
      }
    }
  ],
  "exports": {
    "module": ".",
    "cli": "wechat-format"
  },
  "skills": {
    "entrypoint": "SKILL.md"
  }
}
