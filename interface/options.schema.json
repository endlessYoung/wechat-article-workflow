{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wechat-article-workflow/options.schema.json",
  "title": "wechat_format options",
  "description": "wechat_format 工具的 options 参数 Schema，与 src/core/format.ts 的 FormatOptions 保持一致。",
  "type": "object",
  "properties": {
    "theme": {
      "description": "主题 id（字符串）或自定义主题对象。省略时使用默认主题 minimal。",
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/definitions/theme" }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "style": {
      "type": "object",
      "description": "CSS 样式对象：camelCase 键（如 fontSize/backgroundColor），值为字符串或数字。",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "theme": {
      "type": "object",
      "description": "自定义主题对象。完整字段契约见 docs/theme-guide.md 与 src/themes/types.ts。",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "base": { "type": "object" },
        "colors": { "type": "object" },
        "h1": { "$ref": "#/definitions/style" },
        "h2": { "$ref": "#/definitions/style" },
        "h3": { "$ref": "#/definitions/style" },
        "paragraph": { "$ref": "#/definitions/style" },
        "strong": { "$ref": "#/definitions/style" },
        "em": { "$ref": "#/definitions/style" },
        "link": { "$ref": "#/definitions/style" },
        "inlineCode": { "$ref": "#/definitions/style" },
        "blockquote": { "$ref": "#/definitions/style" },
        "image": { "$ref": "#/definitions/style" },
        "codeBlock": { "type": "object" },
        "list": { "type": "object" },
        "divider": { "type": "object" },
        "callout": { "type": "object" }
      }
    }
  }
}
